# Copy this file to .env and adjust values if needed.

# --- Neo4j (graph + vector index) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j
# Rows written per Neo4j transaction (lower it if Neo4j runs out of memory).
NEO4J_BATCH_SIZE=500

# --- Ollama (local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.1
# Context window (tokens) and max answer length: keep small on CPU.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512

# --- Retrieval (GraphRAG) ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_SYMBOLS=8
# Graph expansion around the best symbols: 1 or 2 hops.
RETRIEVAL_DEPTH=1
# Vector hits below this score are ignored (Neo4j cosine score, 0..1).
RETRIEVAL_MIN_SCORE=0.6
QA_MAX_CONTEXT_CHARS=6000

# --- Embeddings (Hugging Face, runs locally on CPU) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Texts encoded per forward pass on CPU.
EMBEDDING_BATCH_SIZE=32

# --- Ingestion ---
# Where public repositories are cloned (never executed, only read).
REPOS_DIR=./data/repos
# Files larger than this are skipped (bytes).
MAX_FILE_SIZE=500000
# At most this many Python files / total bytes are analysed per repository.
MAX_FILES=2000
MAX_TOTAL_SIZE=20000000
# git clone timeout (seconds).
CLONE_TIMEOUT=120

# --- Background indexing (in memory: tasks are lost when the API restarts) ---
# Indexings running at once (each one loads code + embeddings in RAM).
INDEX_MAX_CONCURRENT=1
# Indexings waiting in the queue; more are refused (HTTP 429).
INDEX_MAX_PENDING=3
# Finished tasks kept for GET /tasks.
TASK_HISTORY=50

# --- Backend / Frontend ---
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
